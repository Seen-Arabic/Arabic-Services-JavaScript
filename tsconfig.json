{
	"compilerOptions": {
		"target": "es5",
		"lib": ["ES2020", "DOM"],
		"module": "CommonJS",
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "**/tests/*"]
}
