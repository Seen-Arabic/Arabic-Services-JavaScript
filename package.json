{
	"name": "arabic-services",
	"version": "1.0.8",
	"description": "Utility functions on Arabic text",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"dev": "ts-node src/index.ts",
		"build": "tsc",
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"test": "jest --config jest.config.cjs --coverage",
		"prepublishOnly": "npm run build",
		"format": "npx prettier --write . --ignore-path .gitignore",
		"lint": "eslint src --quiet",
		"lint:fix": "eslint src --fix",
		"bundle": "webpack"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Seen-Arabic/Arabic-Services-JavaScript.git"
	},
	"keywords": [
		"arabic",
		"arabic-services",
		"services",
		"old-arabic",
		"nlp",
		"tashkeel",
		"tatweel",
		"dotless arabic",
		"language"
	],
	"author": {
		"name": "Seen Arabic",
		"email": "SeenDevelopment@gmail.com",
		"url": "http://seen-arabic.github.io"
	},
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/Seen-Arabic/Arabic-Services-JavaScript/issues"
	},
	"homepage": "https://github.com/Seen-Arabic/Arabic-Services-JavaScript#readme",
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"eslint": "^9.20.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.3",
		"jest": "^29.7.0",
		"prettier": "^3.5.2",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.24.0",
		"webpack": "^5.98.0",
		"webpack-cli": "^5.1.4"
	}
}