{
	"name": "arabic-services",
	"version": "1.1.0",
	"description": "Utility functions on Arabic text",
	"main": "./dist/index.js",
	"module": "./dist/esm/index.js",
	"unpkg": "./dist/umd/arabic-services.umd.js",
	"jsdelivr": "./dist/umd/arabic-services.umd.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"README.md",
		"README_AR.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:cjs": "tsc -p tsconfig.json",
		"build:esm": "tsc -p tsconfig.esm.json && node -e \"fs.writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module', sideEffects: false }))\"",
		"build": "npm run clean && npm run build:cjs && npm run build:esm && npm run bundle",
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"test": "npm run test:unit && npm run build && npm run test:artifacts",
		"test:unit": "vitest run --coverage",
		"test:artifacts": "vitest run --mode artifacts",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build",
		"format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
		"format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
		"lint": "eslint . --quiet",
		"lint:fix": "eslint . --fix",
		"bundle": "webpack"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Seen-Arabic/Arabic-Services-JavaScript.git"
	},
	"keywords": [
		"arabic",
		"arabic-services",
		"services",
		"old-arabic",
		"nlp",
		"tashkeel",
		"tatweel",
		"dotless arabic",
		"language"
	],
	"author": {
		"name": "Seen Arabic",
		"email": "SeenDevelopment@gmail.com",
		"url": "http://seen-arabic.github.io"
	},
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/Seen-Arabic/Arabic-Services-JavaScript/issues"
	},
	"homepage": "https://github.com/Seen-Arabic/Arabic-Services-JavaScript#readme",
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.4",
		"eslint": "^9.20.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.3",
		"prettier": "^3.5.2",
		"ts-loader": "^9.5.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.24.0",
		"vitest": "^5.0.4",
		"webpack": "^5.98.0",
		"webpack-cli": "^5.1.4"
	}
}
